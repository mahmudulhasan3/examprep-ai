# ===== Required: the app will not start without these =====
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# On Neon use the pooled string, for example:

# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15

# Long random text that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=your_secret_key_here

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# ===== Email (Brevo) =====
# Create an API key in Brevo (SMTP & API > API Keys) and verify the sender address
# under Senders. Keep the real values only in your own .env, never commit them.

BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email_here
BREVO_SENDER_NAME=ExamPrep AI

# Where the password reset link and the "Open ExamPrep AI" button point to.

APP_BASE_URL=http://localhost:8501

# true: new accounts must confirm a 6-digit code sent by email (recommended).
# false: skip the email step (handy for local work before Brevo is set up).

EMAIL_VERIFICATION=true

# true: do not send emails, print them in the server log instead (local testing only).

EMAIL_DEV_MODE=false

# ===== Safety limits =====
# Limits on login attempts, guest chat and emails. Leave on in production.

RATE_LIMIT_ENABLED=true

# ===== Docker Compose only =====
# Password for the database container (letters and digits only, so it is safe in a URL).
POSTGRES_PASSWORD=choose_a_password_here

# Ports on your machine. Change them if something else already uses 8001 or 8502.
API_PORT=8001
UI_PORT=8502